PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/youse?schema=public
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Comma-separated E.164 phone numbers allowed to read /api/admin
ADMIN_PHONES=

# Cloudflare R2 S3 API credentials and public bucket/custom-domain URL
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://media.example.com
