{
  "expo": {
    "name": "Youse",
    "slug": "youse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "youse",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.youse.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4EFE7"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.youse.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4EFE7",
          "image": "./assets/images/icon.png",
          "imageWidth": 140
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
