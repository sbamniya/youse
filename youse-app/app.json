{
  "expo": {
    "name": "Youse",
    "slug": "youse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "youse",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.youse.app"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.youse.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Youse to use your camera so you can capture photos.",
          "photosPermission": "Allow Youse to access your photos so you can add them to a memory.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#160d11",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#160d11",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "df0abae0-7a44-4b1c-bf78-decb09b37ea7"
      }
    },
    "owner": "sonu-zest"
  }
}
