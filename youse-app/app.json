{
  "expo": {
    "orientation": "default",
    "scheme": "acme",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.youse.ios"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.youse.ios"
    },
    "web": {
      "bundler": "metro",
      "output": "server"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-router",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "name": "youse-app",
    "slug": "youse-app"
  }
}
